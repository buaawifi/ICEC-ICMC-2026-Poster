% SMU-inspired local color theme for the ICEC/ICMC poster.
% Built for the local Gemini beamerposter theme.

\definecolor{smunavy}{RGB}{24, 32, 84}
\definecolor{smublue}{RGB}{44, 72, 143}
\definecolor{smucyan}{RGB}{0, 149, 170}
\definecolor{smugold}{RGB}{213, 158, 47}
\definecolor{smured}{RGB}{171, 42, 63}
\definecolor{smulight}{RGB}{247, 249, 252}
\definecolor{smuice}{RGB}{231, 245, 249}
\definecolor{smucream}{RGB}{255, 247, 230}
\definecolor{smuink}{RGB}{27, 34, 44}

\setbeamercolor{palette primary}{fg=smuink,bg=white}
\setbeamercolor{palette secondary}{fg=smuink,bg=white}
\setbeamercolor{palette tertiary}{bg=smunavy,fg=white}
\setbeamercolor{palette quaternary}{fg=smuink,bg=white}
\setbeamercolor{structure}{fg=smunavy}

\setbeamercolor{headline}{fg=white,bg=smunavy}
\setbeamercolor{headline rule}{bg=smured}

\setbeamercolor{block title}{fg=smunavy,bg=white}
\setbeamercolor{block separator}{bg=smublue}
\setbeamercolor{block body}{fg=smuink,bg=white}

\setbeamercolor{block title alerted}{fg=white,bg=smunavy}
\setbeamercolor{block separator alerted}{bg=smugold}
\setbeamercolor{block body alerted}{fg=smuink,bg=smucream}

\setbeamercolor{block title example}{fg=smunavy,bg=smuice}
\setbeamercolor{block separator example}{bg=smucyan}
\setbeamercolor{block body example}{fg=smuink,bg=smuice}

\setbeamercolor{heading}{fg=smunavy}
\setbeamercolor{item}{fg=smured}

\setbeamercolor{bibliography item}{fg=smuink}
\setbeamercolor{bibliography entry author}{fg=smuink}
\setbeamercolor{bibliography entry title}{fg=smuink}
\setbeamercolor{bibliography entry location}{fg=smuink}
\setbeamercolor{bibliography entry note}{fg=smuink}
